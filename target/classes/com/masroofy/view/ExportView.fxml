<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.masroofy.controller.ExportController">
    <children>
        <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <Label text="Export Your Data">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>

            <Label style="-fx-text-fill: -text-muted;" text="Choose a format to save your transaction history." />

            <HBox alignment="CENTER" spacing="20.0">
                <Button mnemonicParsing="false" onAction="#handleExportCSV" prefHeight="50.0" prefWidth="120.0" styleClass="action-button" text="Export CSV" />
                <Button mnemonicParsing="false" onAction="#handleExportJSON" prefHeight="50.0" prefWidth="120.0" styleClass="action-button" text="Export JSON" />
                <Button mnemonicParsing="false" onAction="#handleExportXML" prefHeight="50.0" prefWidth="120.0" styleClass="action-button" text="Export XML" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>