<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.masroofy.controller.SettingsController">
   <children>
      <VBox spacing="25.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="40.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBack" styleClass="action-button" text="← Back" />
                  <Label text="Settings">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <Separator prefWidth="200.0" />
            
            <GridPane hgap="15.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Start Date:" GridPane.rowIndex="0" />
                  <DatePicker fx:id="startDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="End Date:" GridPane.rowIndex="1" />
                  <DatePicker fx:id="endDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Total Allowance:" GridPane.rowIndex="2" />
                  <TextField fx:id="allowanceField" promptText="Enter total allowance" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            
            <HBox spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleUpdateCycle" prefHeight="40.0" prefWidth="200.0" styleClass="action-button" text="Update Cycle" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: -danger-color; -fx-font-weight: bold;" text="Danger Zone" />
                  <Separator style="-fx-background-color: -danger-color;" />
                  <Button mnemonicParsing="false" onAction="#handleClearAll" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: -danger-color;" styleClass="action-button" text="Clear All Data" />
                  <Label styleClass="text-muted" text="This will reset your budget and delete all expenses permanently." wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
